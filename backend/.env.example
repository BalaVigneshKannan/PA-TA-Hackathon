DATABASE_MODE=embedded
# For a PostgreSQL server, set DATABASE_MODE=postgres and DATABASE_URL.
DATABASE_URL=postgresql://portal:change-me@localhost:5432/pa_ta_portal
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Optional signed-assertion bridge from the university intranet (see docs/intranet-integration.md).
UNIVERSITY_DOMAIN=dubai.bits-pilani.ac.in
INTRANET_ISSUER=
INTRANET_AUDIENCE=
# PEM RSA public key; encode newlines as \n in a quoted environment value.
INTRANET_PUBLIC_KEY=
# Seed script requires these. No credentials are hard-coded in source.
SEED_ADMIN_EMAIL=admin@dubai.bits-pilani.ac.in
SEED_ADMIN_PASSWORD=
# Optional role accounts for verification; leave blank to skip.
SEED_FACULTY_PASSWORD=
SEED_STUDENT_PASSWORD=
