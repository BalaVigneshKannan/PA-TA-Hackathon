# Same-host TLS proxy example. Replace domain and certificate paths before use.
# See docs/deployment.md for current proxy-trust/rate-limit constraints.
server {
    listen 80;
    server_name portal.example.edu;
    return 301 https://portal.example.edu$request_uri;
}

server {
    listen 443 ssl;
    server_name portal.example.edu;
    ssl_certificate /etc/letsencrypt/live/portal.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.example.edu/privkey.pem;
    client_max_body_size 3m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # The current app does not trust proxy client-IP headers.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_read_timeout 60s;
    }
}
